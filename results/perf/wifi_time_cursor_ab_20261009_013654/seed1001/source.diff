+    /** Related state for one band, with unchanged time-ordered NI history. */
+    struct BandInterferenceState
+    {
+        NiChanges changes; //!< NI history; equal-time insertion order is preserved
+        Watt_u firstPower{0.0}; //!< reference power used by reception/frame capture
+
+        // The cursor is always upper_bound(cursorTime), never a past-power node.
+        // Only queries at Simulator::Now() can advance it; other queries use the tree.
+        NiChanges::iterator cursor;
+        Time cursorTime;
+        bool cursorValid{false};
+
+        BandInterferenceState() = default;
+        BandInterferenceState(const BandInterferenceState& other)
+            : changes(other.changes), firstPower(other.firstPower)
+        {
+        }
+        BandInterferenceState& operator=(const BandInterferenceState& other)
+        {
+            if (this != &other)
+            {
+                cursorValid = false;
+                changes = other.changes;
+                firstPower = other.firstPower;
+            }
+            return *this;
+        }
+
+        NiChanges::iterator UpperBound(Time moment, Time now)
+        {
+            if (moment != now || (cursorValid && moment < cursorTime))
+            {
+                return changes.upper_bound(moment);
+            }
+            if (!cursorValid)
+            {
+                cursor = changes.upper_bound(moment);
+            }
+            else
+            {
+                // Implementation-only bound: avoid long linear walks after time jumps.
+                // Both paths return exactly the same upper_bound.
+                unsigned steps = 0;
+                while (cursor != changes.end() && cursor->first <= moment && steps < 8)
+                {
+                    ++cursor;
+                    ++steps;
+                }
+                if (cursor != changes.end() && cursor->first <= moment)
+                {
+                    cursor = changes.upper_bound(moment);
+                }
+            }
+            cursorTime = moment;
+            cursorValid = true;
+            return cursor;
+        }
+
+        NiChanges::iterator Insert(Time moment, NiChange change, Time now)
+        {
+            auto inserted = changes.insert(UpperBound(moment, now), {moment, change});
+            // Inserting at/before the query cannot change its upper_bound. A new
+            // earlier future node can. Equal future keys retain their old order.
+            if (cursorValid && moment > cursorTime &&
+                (cursor == changes.end() || moment < cursor->first))
+            {
+                cursor = inserted;
+            }
+            return inserted;
+        }
+
+        void ErasePast(NiChanges::iterator first, NiChanges::iterator last, Time cutoff)
+        {
+            // Caller removes only keys <= cutoff. A cursor strictly after cutoff
+            // survives std::multimap::erase; otherwise invalidate before deletion.
+            if (cursorValid && cursorTime < cutoff)
+            {
+                cursorValid = false;
+            }
+            changes.erase(first, last);
+        }
+
+        void ClearHistory()
+        {
+            cursorValid = false;
+            changes.clear();
+        }
+    };
+    using BandStates = std::map<WifiSpectrumBandInfo, BandInterferenceState>;
 
